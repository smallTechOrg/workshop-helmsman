# Workshop Helmsman v0.2 — copy to .env and fill in. `.env` is gitignored; never commit it.

# --- Database ---
# SQLAlchemy URL. Default is SQLite in data/ (local dev only). Production (Cloud Run)
# uses PostgreSQL: postgresql+psycopg://user:pass@host:5432/db (postgres:// and
# postgresql:// are normalised automatically). On Cloud Run this comes from Secret Manager.
DATABASE_URL=sqlite:///data/helmsman.db
# PostgreSQL connection pool (ignored on SQLite). Budget: max-instances x (pool + overflow) <= ~15.
HELMSMAN_DB_POOL_SIZE=3
HELMSMAN_DB_MAX_OVERFLOW=2
# Tests only: a throwaway PostgreSQL database whose name ends in _test (the suite
# refuses anything else). See README "Run the tests".
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/helmsman_test

# --- Server ---
PORT=8001
# 1 (default) = the container entrypoint runs `alembic upgrade head` before serving
# (local docker compose). Cloud Run sets 0: migrations run only in the helmsman-migrate job.
HELMSMAN_MIGRATE_ON_BOOT=1
# Absolute base URL for generated share links (set when running behind a proxy).
# Leave empty to derive from the request.
HELMSMAN_BASE_URL=

# --- Logging ---
HELMSMAN_LOG_LEVEL=INFO

# --- Facilitator access (REQUIRED) ---
# The instance access key entered on the Admin Home page. Choose any strong string (>=16 chars).
HELMSMAN_ADMIN_KEY=

# --- AI help-desk (Phase 4; optional) ---
# Absent => the product runs fully air-gapped with zero errors and AI surfaces show a labelled off state.
OPENROUTER_API_KEY=
HELMSMAN_AI_MODEL=anthropic/claude-sonnet-4-6
HELMSMAN_AI_CONFIDENCE=0.75
